# ============================================
# Discord Welcome Bot - Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.
# ============================================

# Your bot's token from the Discord Developer Portal (Bot tab).
# Treat this like a password. See README.md for how to reset it if leaked.
DISCORD_TOKEN=your_bot_token_here

# The channel where welcome messages should be posted.
# Right-click the channel in Discord (Developer Mode on) -> Copy Channel ID.
WELCOME_CHANNEL_ID=123456789012345678

# Optional: enable/disable sending the welcome message as an embed (true/false).
USE_EMBED=true

# Optional: hex color for the embed (only used if USE_EMBED=true).
EMBED_COLOR=#5865F2

# Optional: bot presence/status text shown under the bot's name.
BOT_ACTIVITY=Watching for new members

# Optional: how many seconds to remember a welcomed member ID, purely to
# guard against Discord occasionally re-delivering the same join event
# (e.g. after a gateway reconnect). Default is 60 if unset.
DEDUPE_WINDOW_SECONDS=60
